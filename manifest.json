{
  "manifest_version": 3,
  "name": "Night Owl",
  "version": "3.12.3",
  "description": "Night Owl for Sleeper fantasy football: draft big board, live cross-league scoring feed, start/sit lineup checks, and betting lines for your starters.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.sleeper.app/*",
    "https://api.sleeper.com/*",
    "https://site.api.espn.com/*",
    "https://sports.core.api.espn.com/*",
    "https://sleeper.com/*",
    "https://theringer.com/*",
    "https://keeptradecut.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Night Owl",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://sleeper.com/*"
      ],
      "js": [
        "src/shared/storage.js",
        "src/shared/dom.js",
        "src/shared/format.js",
        "src/shared/leagues.js",
        "src/shared/api.js",
        "src/shared/account.js",
        "src/shared/teams.js",
        "src/shared/players.js",
        "src/shared/ktc.js",
        "src/live/scoring.js",
        "src/live/tracker.js",
        "src/lineups/core.js",
        "src/season/core.js",
        "src/season/project.js",
        "src/season/value.js",
        "src/season/replacement.js",
        "src/season/model.js",
        "src/season/path.js",
        "src/season/recap.js",
        "src/season/finder.js",
        "src/trades/history.js",
        "src/trades/drafts.js",
        "src/trades/loader.js",
        "src/moves/values.js",
        "src/bets/core.js",
        "src/draft/match-names.js",
        "src/draft/draft-order.js",
        "src/moves/finder-view.js",
        "src/moves/history-view.js",
        "src/moves/drafts-view.js",
        "src/moves/view.js",
        "src/live/view.js",
        "src/lineups/view.js",
        "src/bets/view.js",
        "src/season/extras-view.js",
        "src/season/view.js",
        "src/panel/shell.js",
        "src/draft/board.js",
        "src/draft/badges.js",
        "src/draft/draft.js",
        "src/panel/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/styles/*.css"
      ],
      "matches": [
        "https://sleeper.com/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
